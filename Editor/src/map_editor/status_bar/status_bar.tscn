[gd_scene format=3]

[ext_resource type="Script" path="res://src/map_editor/status_bar/status_bar.gd" id="1_script"]

[node name="StatusBar" type="PanelContainer"]
script = ExtResource("1_script")

[node name="HBox" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="CursorLabel" type="Label" parent="HBox"]
unique_name_in_owner = true
layout_mode = 2
text = "X: —  Y: —"
custom_minimum_size = Vector2(130, 0)

[node name="ZoomLabel" type="Label" parent="HBox"]
unique_name_in_owner = true
layout_mode = 2
text = "100%"

[node name="ProjectLabel" type="Label" parent="HBox"]
unique_name_in_owner = true
layout_mode = 2
text = "No project"

[node name="Spacer" type="Control" parent="HBox"]
layout_mode = 2
size_flags_horizontal = 3

[node name="MapNameLabel" type="Label" parent="HBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Overworld"

[node name="DirtyLabel" type="Label" parent="HBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Saved"
